{
  "name": "paper_plane_x_frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --base=/",
    "build:console": "vue-tsc -b && vite build --base=/ --outDir ../paper_plane_x_backend/data/console --emptyOutDir",
    "build:console:fast": "vite build --base=/ --outDir ../paper_plane_x_backend/data/console --emptyOutDir",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "katex": "^0.16.22",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.0",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6"
  }
}
