{
  "name": "paper_plane_x_frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --base=/",
    "build:console": "vue-tsc -b && vite build --base=/ --outDir ../paper_plane_x_backend/data/console --emptyOutDir",
    "build:console:fast": "vite build --base=/ --outDir ../paper_plane_x_backend/data/console --emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6"
  }
}
